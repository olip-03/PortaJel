<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components1="clr-namespace:Portajel.Structures.ViewModels.Components"
             xmlns:components="clr-namespace:Portajel.Components"
             xmlns:database="clr-namespace:Portajel.Connections.Database;assembly=Portajel.Connections"
             x:Class="Portajel.Components.Media.ModalPlayer"
             x:DataType="components1:MediaPlayerViewModel"
             Title="ModalPlayer">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="500" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <components:MusicImage Grid.RowSpan="3" BlurHash="{Binding Blurhash}"></components:MusicImage>

        <components:FakeShellHeader Grid.Row="0"
                                    IgnoreSystemHeader="False"
                                    Text="Customise Home" />

        <Grid Grid.Row="1" RowDefinitions="Auto, *" HorizontalOptions="Fill">
            <CarouselView x:Name="SongCarousel"
            
                          Position="{Binding QueuePosition}"
                          ItemsSource="{Binding Queue}"
                          Margin="0"
                          IsSwipeEnabled="True"
                          IsBounceEnabled="True"
                          Loop="False"
                          HorizontalOptions="Fill"
                          VerticalOptions="Center"
                          VerticalScrollBarVisibility="Never"
                          HorizontalScrollBarVisibility="Never"
                          CurrentItemChanged="CarouselView_OnCurrentItemChanged">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="database:SongData">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border WidthRequest="340" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6,6,6,6" />
                                </Border.StrokeShape>
                                <components:MusicImage
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    ZIndex="1"
                                    HeightRequest="340"
                                    WidthRequest="340"
                                    HorizontalOptions="Center"
                                    Source="{Binding ImgSource}"
                                    BlurHash="{Binding ImgBlurhash}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
            
            <VerticalStackLayout Grid.Row="1" WidthRequest="340" Margin="0, 12, 0, 48">
                <Label FontSize="22" FontAttributes="Bold" Text="{Binding Current.Name}" HorizontalOptions="Start"
                       HorizontalTextAlignment="Start" />
                <Label FontSize="16" Text="{Binding Current.ArtistNames}" HorizontalOptions="Start"
                       HorizontalTextAlignment="Start" />
            </VerticalStackLayout>
        </Grid>
        
        <Grid Grid.Row="2" RowDefinitions="*,*">
            <VerticalStackLayout Grid.Row="0">
                <HorizontalStackLayout Margin="24, 0" Spacing="6">
                    <components:CircleButton ImageSource="{Binding FavButtonIcon}" Size="42"
                                             BackgroundColor="#1DFFFFFF"
                                             ImageSize="24" Clicked="Favourite_OnClick" />
                    <components:CircleButton ImageSource="library_add.png" Size="42" BackgroundColor="#1DFFFFFF"
                                             ImageSize="24" Text="Save" />
                    <components:CircleButton ImageSource="download.png" Size="42" BackgroundColor="#1DFFFFFF"
                                             ImageSize="24" Text="Download" />
                </HorizontalStackLayout>

                <Slider Margin="8, 0" HorizontalOptions="Fill"></Slider>

                <Grid Margin="24, 0" HorizontalOptions="Fill">
                    <Label Text="00:00" HorizontalOptions="Start"></Label>
                    <Label Text="00:00" HorizontalOptions="End"></Label>
                </Grid>

                <FlexLayout Height="64"
                            Margin="24, 22, 24, 48"
                            Direction="Row"
                            AlignItems="Center"
                            JustifyContent="SpaceBetween">
                    <components:CircleButton
                        ImageSource="media_shuffle.png"
                        Size="42"
                        ImageSize="24"
                        ImageColor="{StaticResource PrimaryTextColor}"
                        Clicked="shuffle_OnClicked" />

                    <components:CircleButton
                        ImageSource="media_skip_prev.png"
                        Size="42"
                        ImageSize="32"
                        ImageColor="{StaticResource PrimaryTextColor}"
                        Clicked="Prev_OnClicked" />

                    <components:CircleButton
                        ImageSource="{Binding PlayPauseIcon}"
                        Size="64"
                        ImageSize="38"
                        ImageColor="{StaticResource BackgroundColor}"
                        BackgroundColor="{StaticResource PrimaryTextColor}"
                        Clicked="PlayPause_OnClicked" />

                    <components:CircleButton
                        ImageSource="media_skip_next.png"
                        Size="42"
                        ImageSize="32"
                        ImageColor="{StaticResource PrimaryTextColor}"
                        Clicked="Next_OnClicked" />

                    <components:CircleButton
                        ImageSource="media_repeat.png"
                        Size="42"
                        ImageSize="24"
                        ImageColor="{StaticResource PrimaryTextColor}"
                        Clicked="Repeat_OnClicked" />
                </FlexLayout>
            </VerticalStackLayout>
            
            <FlexLayout Grid.Row="1" Direction="Row" AlignItems="Center" VerticalOptions="Start" HorizontalOptions="Fill"
                        JustifyContent="SpaceAround">
                <Button Text="Up Next" Background="Transparent" />
                <Button Text="Lyrics" Background="Transparent" />
                <Button Text="Similar" Background="Transparent" />
            </FlexLayout>
        </Grid>
    </Grid>
</ContentPage>