<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:music="clr-namespace:Portajel.Connections.Database;assembly=Portajel.Connections"
             xmlns:components="clr-namespace:Portajel.Components"
             xmlns:local="clr-namespace:Portajel.Pages"
             xmlns:adaptor="clr-namespace:Portajel.Structures.Adaptor"
             xmlns:converters="clr-namespace:Portajel.Structures.Converters"
             xmlns:controls="clr-namespace:Microsoft.Maui.Controls;assembly=VirtualListView"
             x:DataType="local:SearchPageViewModel"
             x:Class="Portajel.Pages.SearchPage"
             Title="Search">
    <ContentPage.Resources>
        <ResourceDictionary>
            <adaptor:ListTemplateSelector x:Key="ItemTemplateSelector" />
            <converters:ImageUrlConverter x:Key="ImageUrlConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="Auto,Auto,*" 
          RowSpacing="0">
        <SearchBar Grid.Row="0"
                   ZIndex="5"
                   Background="{StaticResource BackgroundColor}"
                  x:Name="SearchBar"
                  SearchButtonPressed="SearchBar_OnSearchButtonPressed"
                  TextChanged="SearchBar_TextChanged" />
        

        
        <controls:VirtualListView
            Grid.Row="2"
            x:Name="Vlv"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            IsRefreshEnabled="True"
            SelectionMode="None"
            OnRefresh="Vlv_OnOnRefresh"
            ItemTemplateSelector="{StaticResource ItemTemplateSelector}">
